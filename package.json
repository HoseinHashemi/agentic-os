{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd server && npm run dev",
    "start": "concurrently --names \"UI,Server\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "setup": "npm install && cd server && npm install && cd ..",
    "postinstall": "echo \"\\n✓ Frontend deps installed. Run: cd server && npm install\\n\""
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
